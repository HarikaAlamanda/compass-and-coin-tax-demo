# Environment variables for local development.
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already excluded via .gitignore.

# No environment variables are required yet for Phase 1.
# This file will be updated as future phases introduce real configuration
# (for example, a form submission endpoint or analytics key).

# Base URL of the local/demo FastAPI backend (M3). Defaults to
# http://localhost:8000 in code if unset. Do not set a production URL here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend-side (not used by Next.js): the deployed frontend's origin, allowed by
# FastAPI CORS in addition to http://localhost:3000. Set this on the backend host,
# not here. Documented for reference only — no secret value.
FRONTEND_ORIGIN=https://your-app.vercel.app
